# Copy to .env.nbs and fill in real values. Do NOT commit your env file.

# Public base URL for digital human tasks (must be publicly accessible)
EXTERNAL_BASE_URL=

# Image (text-to-image) system keys/base URL (override config.json)
IMAGE_API_KEY=
IMAGE_BACKUP_KEYS=
IMAGE_BASE_URL=
# Image models
IMAGE_MODEL=
# Separate LLM for prompt optimization (optional; falls back to IMAGE_MODEL)
IMAGE_LLM_MODEL=
# Per-model image keys (format: model=key,model2=key2 or JSON map)
IMAGE_MODEL_KEY_MAP=

# TTS system keys/base URL (override config.json)
TTS_API_KEY=
TTS_BACKUP_KEYS=
TTS_BASE_URL=

# Video (digital human) system keys/base URL (override config.json)
VIDEO_API_KEY=
VIDEO_BACKUP_KEYS=
VIDEO_BASE_URL=

# Batch generation concurrency
BATCH_WORKERS=2
BATCH_DELAY_SECONDS=0

# Optional: use OSS for public uploads
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
OSS_UPLOAD_PREFIX=uploads

# Frontend upload endpoint (override default /api/upload)
# Example: /api/upload_public
VITE_PUBLIC_UPLOAD_URL=/api/upload

# Assistant (Kimi / Moonshot)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
ASSISTANT_MODEL=kimi-k2.5
# Max chars injected per uploaded file into chat context
ASSISTANT_MAX_FILE_CONTEXT_CHARS=120000
